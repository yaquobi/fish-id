# انسخه إلى .env على السيرفر. لا يُرفع على GitHub.
ANTHROPIC_API_KEY=sk-ant-...
# اختياري:
# FISHID_MODEL=claude-opus-5-5
# FISHID_EFFORT=high
# FISHID_PER_MINUTE=30
# دفع باقة المحلات (hawat.id/shop) عن طريق ميسر. من لوحة ميسر: Settings > API Keys.
# مفاتيح التجربة pk_test_/sk_test_ للتجربة، وبعد تفعيل الحساب نبدلها بـ pk_live_/sk_live_.
# FISHID_MOYASAR_PK=pk_test_...
# FISHID_MOYASAR_SK=sk_test_...
# الرمز السري للـ webhook (نفس اللي ينكتب في ميسر > Webhooks، الرابط https://hawat.id/api/moyasar، الحدث payment_paid):
# FISHID_MOYASAR_WEBHOOK=...
# طرق الدفع: creditcard (مدى والبطاقات) دايمًا، و applepay و stcpay بعد تفعيلها في ميسر:
# FISHID_MOYASAR_METHODS=creditcard,applepay
