# الواجهة على سيرفر جوجل بعد go-live: نفس توزيع nginx على Hostinger.
hawat.id, www.hawat.id {
	encode zstd gzip
	handle_path /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy 127.0.0.1:18490 {
			transport http {
				read_timeout 120s
			}
		}
	}
	handle {
		root * /srv/landing
		header Access-Control-Allow-Origin *
		try_files {path} {path}/ /index.html
		file_server
	}
}
ksafish.com, www.ksafish.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18500
}
